rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      // Permite leitura pública de imagens e relatórios gerados
      allow read: if true;
      // Permite upload e modificação apenas para usuários autenticados
      allow write: if request.auth != null;
    }
  }
}
